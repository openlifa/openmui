[[nodiscard]] constexpr std::string_view name(Role v) noexcept {
    auto i = static_cast<std::size_t>(v);
    return i < roles.size() ? roles[i].name : std::string_view{};
}

[[nodiscard]] constexpr std::optional<Role> parse_role(std::string_view text) noexcept {
    for (std::size_t i = 0; i < roles.size(); ++i)
        if (roles[i].name == text) return static_cast<Role>(i);
    return std::nullopt;
}

// Interactive roles must have a name (S-6) and should have an explicit id.
[[nodiscard]] constexpr bool interactive(Role r) noexcept {
    auto i = static_cast<std::size_t>(r);
    return i < roles.size() && roles[i].interactive;
}

struct StateInfo {
    std::string_view name;
    std::string_view doc;
};

// A state bit of a semantic node (states.toml); the enumerator is the bit index.
enum class State : std::uint8_t {
    disabled,
    focusable,
    focused,
    hovered,
    pressed,
    checked,
    mixed,
    selected,
    expanded,
    collapsible,
    busy,
    hidden,
    offscreen,
    invalid,
    required,
    readonly,
    editable,
    multiline,
    multiselectable,
    modal,
    default_,
    visited,
    animating,
    removing,
};

inline constexpr std::array<StateInfo, 24> states{{
    {"disabled", "Present but not operable; actions other than `read` are refused."},
    {"focusable", "Can receive keyboard focus."},
    {"focused", "Has keyboard focus."},
    {"hovered", "A pointer is over it."},
    {"pressed", "Being pressed (pointer or key held)."},
    {"checked", "On: a checkbox, switch, toggle button or checkable menu item."},
    {"mixed", "Neither checked nor unchecked (a tri-state checkbox)."},
    {"selected", "Selected within its container (an option, a tab, a list item)."},
    {"expanded", "Its controlled content is shown (a disclosure, a combo box, a tree item)."},
    {"collapsible", "Can be expanded or collapsed; `expanded` tells which."},
    {"busy", "Being updated; its content may change soon."},
    {"hidden", "Not shown (kept in the tree for virtualised or off-screen content)."},
    {"offscreen", "Outside the visible area of its scroll container."},
    {"invalid", "Its value fails validation."},
    {"required", "Must have a value before the form it belongs to is submitted."},
    {"readonly", "Its value can be read and selected but not changed."},
    {"editable", "Its text can be edited."},
