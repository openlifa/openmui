struct ActionInfo {
    std::string_view         name;
    Effect                   effect;
    std::span<const ArgInfo> args;
    std::string_view         doc;
};

// The common actions (actions.toml); a component may declare a stronger effect.
enum class Action : std::uint8_t {
    activate,
    focus,
    blur,
    toggle,
    set_value,
    increment,
    decrement,
    expand,
    collapse,
    select,
    deselect,
    dismiss,
    open_menu,
    scroll_into_view,
    scroll_to,
    scroll_by,
    set_selection,
    replace_selection,
    move_to,
    resize,
    seek,
};

inline constexpr std::array<ActionInfo, 21> actions{{
    {"activate", Effect::reversible, {}, "Do what the element is for: press a button, follow a link, choose an option."},
    {"focus", Effect::read, {}, "Move keyboard focus to the element."},
    {"blur", Effect::read, {}, "Remove keyboard focus from the element."},
    {"toggle", Effect::reversible, {}, "Flip the checked state of a checkbox, switch or toggle button."},
