    {"animating", "Moving; bounds and values given are those of the target state."},
    {"removing", "Leaving the tree (exit animation); accepts no actions (S-4)."},
}};

[[nodiscard]] constexpr std::string_view name(State v) noexcept {
    auto i = static_cast<std::size_t>(v);
    return i < states.size() ? states[i].name : std::string_view{};
}

[[nodiscard]] constexpr std::optional<State> parse_state(std::string_view text) noexcept {
    for (std::size_t i = 0; i < states.size(); ++i)
        if (states[i].name == text) return static_cast<State>(i);
    return std::nullopt;
}

struct EffectInfo {
    std::string_view name;
    int              tier;
    bool             answer;
    std::string_view doc;
};

// What performing an action does (effects.toml; openas §3.1).
enum class Effect : std::uint8_t {
    read,
    reversible,
    irreversible,
    external,
};

inline constexpr std::array<EffectInfo, 4> effects{{
    {"read", 0, false, "Observes state and changes nothing."},
    {"reversible", 1, false, "Changes state in a way the user can undo (typing, moving, toggling)."},
    {"irreversible", 2, true, "Changes state in a way that cannot be undone (deleting, sending, paying). Needs an answer (S-1)."},
    {"external", 2, true, "Reaches outside the application (opens a link, starts a program, uses the network). Needs an answer (S-1)."},
}};

[[nodiscard]] constexpr std::string_view name(Effect v) noexcept {
    auto i = static_cast<std::size_t>(v);
    return i < effects.size() ? effects[i].name : std::string_view{};
}

[[nodiscard]] constexpr std::optional<Effect> parse_effect(std::string_view text) noexcept {
    for (std::size_t i = 0; i < effects.size(); ++i)
        if (effects[i].name == text) return static_cast<Effect>(i);
    return std::nullopt;
}

// S-1: an action of this effect must state its answer.
[[nodiscard]] constexpr bool requires_answer(Effect e) noexcept {
    auto i = static_cast<std::size_t>(e);
    return i >= effects.size() || effects[i].answer;
}

// The order of the rule "stronger, never weaker"; an unknown effect is the strongest.
[[nodiscard]] constexpr int tier(Effect e) noexcept {
    auto i = static_cast<std::size_t>(e);
    return i < effects.size() ? effects[i].tier : 1000;
}

