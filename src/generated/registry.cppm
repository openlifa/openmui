}};

[[nodiscard]] constexpr std::string_view name(Origin v) noexcept {
    auto i = static_cast<std::size_t>(v);
    return i < origins.size() ? origins[i].name : std::string_view{};
}

[[nodiscard]] constexpr std::optional<Origin> parse_origin(std::string_view text) noexcept {
    for (std::size_t i = 0; i < origins.size(); ++i)
        if (origins[i].name == text) return static_cast<Origin>(i);
    return std::nullopt;
}

