{
  "contract": {
    "tabs": {
      "children": "tab",
      "role": "tab_list",
      "spec": "0.1",
      "doc": "A set of tabs selecting one panel.",
      "props": {
        "selected": {
          "type": "string",
          "default": "",
          "bindable": true,
          "doc": "The id of the selected tab."
        },
        "variant": {
          "type": "enum",
          "values": [
            "line",
            "bar"
          ],
          "default": "line",
          "doc": "line: the selected tab underlined; bar: the tabs on a capsule, the selected one in a lens that slides to it, stretching as it goes (a segmented control, a floating tab bar)."
        }
      },
      "events": {
        "changed": {
          "args": {
            "selected": "string"
          }
        }
      },
      "keys": {
        "Right": "next",
        "Left": "previous"
      },
      "parts": {
        "strip": {},
        "indicator": {}
      },
      "motion": {
        "indicator": "motion.spring.snappy"
      },
      "commands": {
        "next": {
          "doc": "Select the next tab."
        },
        "previous": {
          "doc": "Select the previous tab."
        }
      }
    },
    "tab": {
      "role": "tab",
      "spec": "0.1",
      "doc": "A tab of a tab list.",
      "props": {
        "text": {
          "type": "string",
          "default": ""
        },
        "disabled": {
          "type": "bool",
          "default": false
        }
      },
      "actions": {
        "select": {
          "effect": "reversible"
        },
        "activate": {
          "effect": "reversible"
        }
      }
    }
  }
}
